# Copie ce fichier en .env sur le serveur et remplis-le. Ne le mets JAMAIS dans le dépôt.
LF_ENV=test                    # test ou prod
LF_ALLOW_TEST_LOGIN=true       # true seulement sur le serveur de test
LF_DOMAIN=test.exemple.fr      # nom de domaine qui pointe vers le VPS
POSTGRES_PASSWORD=
LF_SERVER_KEY=                 # clé publique du jeu (aussi dans client/config.json)
LF_SESSION_KEY=                # 32 caractères au hasard
LF_REFRESH_KEY=                # 32 caractères au hasard
LF_HTTP_KEY=                   # 32 caractères au hasard
LF_CONSOLE_USER=elowan
LF_CONSOLE_PASSWORD=
LF_DISCORD_CLIENT_ID=
LF_DISCORD_CLIENT_SECRET=
